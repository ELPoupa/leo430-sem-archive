{\up $}{\footnote\pard\plain{\up $} Acquire command error}
{\up #}{\footnote\pard\plain{\up #} 1KZ.VCK}
\pard \b\fs24 Acquire command error
\par 
\par \plain\fs24 This error is given when a signal acquisition  command fails.
\par 
\par Code numbers greater than 40 indicate the failure of an internal consistency check.  \ul \f3\ul\fs20 Contact LEO\plain\f3\fs20 {\v 2JJ8T6_}\f1\fs24 
\par 
\par Cod{\up K}{\footnote\pard\plain{\up K} Errors}
e numbers  less than 40 indicate that there is a failure in the communication to the DSP subsystem.
\par \uldb \f3\fs20 Report problem\plain\f3\fs20 {\v P8W0Q0}\f1\fs24 
\par 
\par The code number given identifies the failing command as follows:
\par 
\par 1 SET_ZONE_K1_CMD           
\par 2 SET_ZONE_K2_CMD          
\par 3 SET_ZONE_ALPHA_CMD       
\par \pard 4 SET_ZONE_BETA_CMD        
\par 5 SET_ZONE_SUB_CMD          
\par 6 SET_ZONE_PORT_CMD        
\par 7 SET_ZONE_OFFSET_CMD      
\par 8 SET_ZONE_GAIN_CMD        
\par 9 SET_ZONE_INVERT_CMD      
\par A CREATE_IDENTITY_LUT       
\par B CREATE_GAMMA_LUT          
\par C CREATE_INVERT_LUT         
\par D CREATE_USER_LUT           
\par E COMBINE_USER_LUTS         
\par F ENABLE_WINDOW_PLANE       
\par 10 SET_DETECTOR_MIXING       
\par 11 SET_FAVE_NOISE_REDN       
\par 12 SET_LINT_NOISE_REDN       
\par 13 SET_FINT_NOISE_REDN       
\par \pard 14 SET_WINDOW_SEL            
\par 15 SET_FREEZE_CMD            
\par 16 COPY_USER_LUT            
\par 17 SEE_LUT                   
\par 18 DEFINE_WINDOW             
\par \page
