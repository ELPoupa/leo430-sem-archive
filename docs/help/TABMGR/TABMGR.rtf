\par It provides following features for selection and adjustment:
\par 
\par \trowd\trgaph105\trleft-116 \cellx7365\cellx10465\pard\intbl \uldb \b Auto Initialise Stage\plain\b\fs24 {\v Auto_Initialise_Stage}\plain\fs24 
\par\intbl 
\par\intbl \b Backlash \plain\fs24 has two commands:\uldb \b Backlash On\plain\b\fs24 {\v Backlash_On} \plain\fs24 and\b  \uldb Do Backlash\plain\b\fs24 {\v Do_Backlash}
\par\intbl \plain\fs24 
