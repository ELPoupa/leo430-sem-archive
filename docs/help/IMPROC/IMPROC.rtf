{\up $}{\footnote\pard\plain{\up $} Filter Types}
{\up #}{\footnote\pard\plain{\up #} Filter_Types}
{\up >}{\footnote\pard\plain{\up >} main}
\pard\keepn \b\fs36\cf1 Filter Types
\par \pard \plain\fs24 
\par This function defines which of the \uldb \b Convolution Kernels\plain\b\fs24 {\v Convolution_Kernel}\plain\fs24  is to be swept across the image store producing a result for each pixel. The result is then normalised to the range 0..255. 
\par 
\par All the Kernels are a 3 by 3 matrix of signed integers. (User defined filters may have up to 5 by 5 matrices)
\par 
\par The following types of filters may be used to transform the image:
\par 
\par \pard\tx355 \tab \{bmc bm6.bmp\}\tab \uldb \b User Defined...\plain\b\fs24 {\v User_Defined_Filter}
\par \plain\fs24 
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Smooth\plain\b\fs24 {\v Filter_Type_Smooth}\plain\fs24 
\par 
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Sharpen\plain\b\fs24 {\v Filter_Type_Sharpen}\plain\fs24 .
\par 
\par \ul \tab \{bmc bm6.bmp\}\tab \plain\uldb\fs24 \b Sharpen 2\plain\b\fs24 {\v Filter_Type_Sharpen_2}\plain\fs24 .
\par 
\par \ul \tab \{bmc bm6.bmp\}\tab \plain\uldb\fs24 \b Horizontal Edge Detection\plain\b\fs24 {\v Filter_Type_Horizontal_Edge}
\par \plain\fs24 .
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Vertical Edge Detection\plain\b\fs24 {\v Filter_Type_Vertical_Edge}\plain\fs24 .
\par 
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Edge Detection\plain\b\fs24 {\v Filter_Type_Edge_Detect}
\par 
\par \tab \{bmc bm6.bmp\}\tab \uldb Edge Detection 2\plain\b\fs24 {\v Filter_Type_Edge_Detect_2}\plain\fs24 
\par 
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Laplacian\plain\b\fs24 {\v Filter_Type_Laplacian}\plain\fs24 .
\par 
\par \tab \{bmc bm6.bmp\}\tab \uldb \b Laplacian 2\plain\b\fs24 {\v Filter_Type_Laplacian_2}\plain\fs24 .
\par \page
