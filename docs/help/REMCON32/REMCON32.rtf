\pard {\up K}{\footnote\pard\plain{\up K} About;Hang up}
\fs24 About
\par Displays the about box dialog, containing {\up K}{\footnote\pard\plain{\up K} General Description}
version number and copyright information.
\par \page
{\up $}{\footnote\pard\plain{\up $} Baud Rate}
{\up #}{\footnote\pard\plain{\up #} Baud_Rate}
\pard {\up K}{\footnote\pard\plain{\up K} Auto Start of RemCon32 when logging on to the SEM User Interface}
\fs36 Baud Rate
\par \fs24 This setting determines the speed at which characters are transferred across the RS232 connection. It is important that the same speed is selected within Remcon32 as in the program running on the remote PC.
\par \page
{\up $}{\footnote\pard\plain{\up $} COM port selection}
{\up #}{\footnote\pard\plain{\up #} L0TTZY}
\pard\keepn \fs36 COM port selection
\par \pard \fs24 This control selects which com port Remcon32 will address.
\par \page
{\up $}{\footnote\pard\plain{\up $} Clear Terminal}
{\up #}{\footnote\pard\plain{\up #} 8I98O9}
\pard Clear Terminal
\par Clears the text window (without affecting the contents of the log file if it is open).
\par \page
{\up $}{\footnote\pard\plain{\up $} Close Log File}
{\up #}{\footnote\pard\plain{\up #} 1IQ5_DN}
\pard {\up K}{\footnote\pard\plain{\up K} Baud Rate;Clear Terminal}
\fs36 Close Log File
\par \fs24 Terminates the logging of commands and responses and closes the command log file.
\par Remcon32 will continue to process commands after the log file has been closed.
\par \page
{\up $}{\footnote\pard\plain{\up $} Close Port}
{\up #}{\footnote\pard\plain{\up #} 1MM950M}
\pard Close Port
\par Closes the comms port at the end of a session.
\par \page
