\par\intbl Pin 11 \tab \tab Busy (PBSY)
\par\intbl Pin 12\tab \tab \tab Printer Paper End (no paper) (PRPE)
\par\intbl Pin 13\tab \tab \tab Select (PSLT)
\par\intbl Pin 14\tab \tab \tab Automatic Supply (PAUT)
\par\intbl Pin 15\tab \tab \tab Error (ERRP)
\par\intbl Pin 16\tab \tab \tab Initialise Printer (PINI)
\par\intbl Pin 17\tab \tab \tab Selection (PSCI)
\par\intbl Pins 18 to Pin 25\tab Signal Ground (GND)\cell\pard \pard\intbl\tx355 
\par\intbl 
\par\intbl 
\par\intbl 
\par\intbl 
\par\intbl 
\par\intbl 
\par\intbl     \{bmc bm113.wmf\}\cell\intbl\row
