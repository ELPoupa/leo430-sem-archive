\par <\uldb F7\plain\b\fs24 {\v F7_Key}>, <\uldb F7 + SHIFT\plain\b\fs24 {\v F7___SHIFT_Key}>
\par <\uldb F8\plain\b\fs24 {\v F8_Key}>, <\uldb F8 + SHIFT\plain\b\fs24 {\v F8___SHIFT_Key}> \tab \plain\fs24 \tab 
