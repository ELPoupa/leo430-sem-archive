\pard\keepn \b\fs36\cf1 Text Selection Keys
\par \pard \plain\fs24 
\par \pard\li3735\fi-3735\tx3735 \b Key(s)\tab Function
\par 
\par <SHIFT + \f3 \'ac \f4 > \plain\fs24 or\b  <SHIFT + \f3 \'ae \f4 >\plain\fs24 \tab Selects text one character at a time to the left or right.
\par \b <SHIFT + \f3 \'af\f4  > \plain\fs24 or\b  <SHIFT + \f3 \'ad\f4  >\plain\fs24 \tab Selects one line of text up or down.
